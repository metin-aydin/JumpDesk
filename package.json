{
  "name": "jumpdesk",
  "productName": "JumpDesk",
  "desktopName": "jumpdesk.desktop",
  "version": "0.2.0",
  "description": "Cross-platform desktop client for JumpServer (open-source PAM/bastion): tabbed SSH, RDP and SFTP sessions, split panes, snippets, alarm and highlight rules",
  "main": "./out/main/index.js",
  "author": "metin-aydin",
  "license": "MIT",
  "homepage": "https://github.com/metin-aydin/JumpDesk",
  "repository": {
    "type": "git",
    "url": "https://github.com/metin-aydin/JumpDesk.git"
  },
  "bugs": "https://github.com/metin-aydin/JumpDesk/issues",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview -- --ozone-platform=x11",
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "dev:mock": "cross-env JUMPDESK_SERVER=http://127.0.0.1:18080 electron-vite dev -- --ozone-platform=x11",
    "mock": "node dev/mock-jms/server.mjs",
    "desktop-entry": "sh dev/install-desktop-entry.sh",
    "screenshots": "node dev/screenshots.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.10"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/guacamole-common-js": "^1.5.5",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "guacamole-common-js": "^1.5.0",
    "lucide-react": "^1.57.0",
    "node-pty": "^1.1.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  }
}
